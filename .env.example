# --- app ---
ENVIRONMENT=local                 # local | staging | production
DEBUG=false
API_PREFIX=/api/v1

# --- security (REQUIRED in production) ---
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- rate limiting ---
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- database (local default = sqlite; production example below) ---
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
# DATABASE_URL=postgresql+asyncpg://taskflow:STRONG_PASSWORD@db:5432/taskflow

# --- redis ---
REDIS_ENABLED=false
# REDIS_ENABLED=true
# REDIS_URL=redis://cache:6379/0

# --- cors ---
# CORS_ORIGINS=["https://yourapp.com"]
